{
    "name": "structuraphp/structura-laravel",
    "description": "Laravel extension for Structura - Architectural testing stubs for Laravel applications",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "StructuraPhp\\StructuraLaravel\\": "src/"
        }
    },
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.3",
        "structuraphp/structura": "dev-develop",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.3",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "StructuraPhp\\StructuraLaravel\\StructuraServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
