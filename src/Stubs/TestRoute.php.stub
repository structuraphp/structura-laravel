<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Support\Facades\Route;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Enums\IncludeType;
use StructuraPhp\Structura\ExprScript;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestRoute extends TestBuilder
{
    #[TestDox('We want to architect our <info>routes</info>')]
    public function testRouteArchitecture(): void
    {
        $this
            ->allScripts()
            ->fromDir('{{ path }}')
            ->should(
                static fn (ExprScript $assert): ExprScript => $assert
                    ->toUseStrictTypes()
                    ->dependsOnlyOn(
                        names: [
                            Route::class,
                        ],
                        patterns: [
                            'App\Http\(Controllers|Middleware)\.*',
                            'Illuminate\Auth\Middleware\.*',
                            'Illuminate\Foundation\Http\Middleware\.*',
                        ]
                    )
                    ->toUseInclude(IncludeType::Require),
            );
    }
}

