<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\Pivot;
use Illuminate\Foundation\Auth\User;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;
use StructuraPhp\Structura\ValueObjects\ClassDescription;

final class TestModel extends TestBuilder
{
    #[TestDox('We want to architect our <info>models</info>')]
    public function testModelsArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->or(
                        static fn (Expr $expr): Expr => $expr
                            ->toExtend(Model::class)
                            ->toExtend(Pivot::class)
                            ->toExtend(User::class)
                    )
                    ->toHaveCorrespondingClass(
                        static fn (ClassDescription $classDescription): string => preg_replace(
                            '/^App\\\Models\\\(.+?)$/',
                            'Database\\\Factories\\\$1Factory',
                            $classDescription->namespace,
                        )
                    )
                    ->toHaveCorrespondingClass(
                        static fn (ClassDescription $classDescription): string => preg_replace(
                            '/^App\\\Models\\\(.+?)$/',
                            'App\\\Policies\\\$1Policy',
                            $classDescription->namespace,
                        )
                    )
            );
    }
}

