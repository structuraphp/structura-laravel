<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Database\Seeder;
use Illuminate\Database\Console\Seeds\WithoutModelEvents;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestSeeder extends TestBuilder
{
    #[TestDox('We want to architect our <info>seeders</info>')]
    public function testSeedersArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toHaveSuffix('Seeder')
                    ->toExtend(Seeder::class)
                    ->toImplementNothing()
                    ->dependsOnlyOnUseTrait(
                        names: [
                            WithoutModelEvents::class,
                        ],
                    )
                    ->toHaveMethod('run'),
            );
    }
}
