<?php

declare(strict_types=1);

namespace {{ namespace }};

use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestService extends TestBuilder
{
    #[TestDox('We want to architect our <info>services</info>')]
    public function testServicesArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toBeReadonly()
                    ->toHaveSuffix('Service'),
            );
    }
}

