<?php

declare(strict_types=1);

namespace {{ namespace }};

use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class ServiceTest extends TestBuilder
{
    #[TestDox('Services should have proper architecture')]
    public function testServicesShouldHaveProperArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeReadonly()
                    ->toHaveSuffix('Service'),
            );
    }
}

