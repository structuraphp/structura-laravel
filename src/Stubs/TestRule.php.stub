<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Contracts\Validation\DataAwareRule;
use Illuminate\Contracts\Validation\ValidationRule;
use Illuminate\Contracts\Validation\ValidatorAwareRule;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestRule extends TestBuilder
{
    #[TestDox('We want to architect our <info>rules</info>')]
    public function testRulesArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toHaveSuffix('Rule')
                    ->toExtendsNothing()
                    ->toImplement(ValidationRule::class)
                    ->dependsOnlyOnImplementation(
                        names: [
                            DataAwareRule::class,
                            ValidatorAwareRule::class,
                        ],
                    )
                    ->toNotUseTrait(),
            );
    }
}
