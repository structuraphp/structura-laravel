<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\View\Component;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestComponent extends TestBuilder
{
    #[TestDox('We want to architect our <info>components</info>')]
    public function testComponentsArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toHaveSuffix('Component')
                    ->toExtend(Component::class)
                    ->toImplementNothing()
                    ->toNotUseTrait(),
            );
    }
}
