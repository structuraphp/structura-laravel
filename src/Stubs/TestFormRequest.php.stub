<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Foundation\Http\FormRequest;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestFormRequest extends TestBuilder
{
    #[TestDox('Form Requests should extend FormRequest and have rules')]
    public function testFormRequestsShouldExtendFormRequestAndHaveRules(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toHaveSuffix('Request')
                    ->toExtend(FormRequest::class)
                    ->toImplementNothing()
                    ->toHaveMethod('rules'),
            );
    }
}

