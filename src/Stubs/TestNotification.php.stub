<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Notifications\Notification;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestNotification extends TestBuilder
{
    #[TestDox('Notifications should extend Notification')]
    public function testNotificationsShouldExtendNotification(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toExtend(Notification::class),
            );
    }
}

