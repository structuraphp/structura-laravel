<?php

declare(strict_types=1);

namespace {{ namespace }};

use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Foundation\Queue\Queueable;
use Illuminate\Queue\SerializesModels;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestJob extends TestBuilder
{
    #[TestDox('We want to architect our <info>jobs</info>')]
    public function testJobsArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toHaveSuffix('Job')
                    ->toExtendsNothing()
                    ->or(
                        static fn (Expr $expr): Expr => $expr
                            ->toImplement(ShouldQueue::class)
                            ->toImplement(ShouldQueueAfterCommit::class),
                    )
                    ->dependsOnlyOnUseTrait(
                        names: [
                            Queueable::class,
                            SerializesModels::class,
                        ],
                        message: 'We recommend using the dispatcher, rather than the Dispatchable trait',
                    )
                    ->toHaveMethod('handle'),
            );
    }
}

