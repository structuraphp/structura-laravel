<?php

declare(strict_types=1);

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestController extends TestBuilder
{
    #[TestDox('We want to architect our <info>controllers</info>')]
    public function testControllersArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->that(
                static fn (Expr $expr): Expr => $expr
                    // To ignore the abstract class at the root of Laravel projects
                    ->notToBeInOneOfTheNamespaces(Controller::class)
            )
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->toHaveSuffix('Controller')
                    ->toExtend(Controller::class)
                    ->toImplementNothing()
                    ->toNotUseTrait(),
            );
    }
}

