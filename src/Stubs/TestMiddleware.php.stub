<?php

declare(strict_types=1);

namespace {{ namespace }};

use StructuraPhp\Structura\Attributes\TestDox;
use StructuraPhp\Structura\Expr;
use StructuraPhp\Structura\Testing\TestBuilder;

final class TestMiddleware extends TestBuilder
{
    #[TestDox('We want to architect our <info>middleware</info>')]
    public function testMiddlewaresArchitecture(): void
    {
        $this
            ->allClasses()
            ->fromDir('{{ path }}')
            ->should(
                static fn (Expr $assert): Expr => $assert
                    ->toUseStrictTypes()
                    ->toBeClasses()
                    ->toBeFinal()
                    ->or(
                        static fn (Expr $expr): Expr => $expr
                            ->and(
                                static fn (Expr $expr): Expr => $expr
                                    ->toExtendsNothing()
                                    ->toBeReadonly()
                                    ->toHaveMethod('handle'),
                            )
                            ->dependsOnlyOnInheritance(
                                patterns: [
                                    'Illuminate\.*\Middleware\.*',
                                ],
                            )
                    )
                    ->toImplementNothing()
                    ->toNotUseTrait()
                    ->toHaveMethod('handle'),
            );
    }
}

